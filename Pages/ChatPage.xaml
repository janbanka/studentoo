<Page x:Class="studentoo.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Czat" Height="450" Width="800"
      Background="#FFF5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0" Background="#FFFE3C72" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" FontSize="16" 
                        Click="BackButton_Click" Foreground="White" Background="Transparent"
                        BorderThickness="0" Margin="0,0,10,0">
                    <Image Source="/Icons/back-arrow.png" Height="30" Width="30" Stretch="Uniform"/>
                </Button>
                <Image x:Name="PartnerImage" Width="40" Height="40">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="20" RadiusY="20" Center="10,15"/>
                    </Image.Clip>
                </Image>
                <TextBlock x:Name="PartnerNameText" Foreground="White" FontSize="16" 
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Lista wiadomości -->
        <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" Padding="10">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <!-- Wiadomość od partnera -->
                            <StackPanel HorizontalAlignment="Left" Visibility="{Binding IsFromCurrentUser, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}">
                                <Border Background="#FFFFFF" CornerRadius="10 10 10 0" Padding="10" MaxWidth="300">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}" 
                                           Foreground="Gray" FontSize="10" Margin="5,2"/>
                            </StackPanel>

                            <!-- Wiadomość od nas -->
                            <StackPanel HorizontalAlignment="Right" Visibility="{Binding IsFromCurrentUser, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="#FFFE3C72" CornerRadius="10 10 0 10" Padding="10" MaxWidth="300">
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}" 
                                           Foreground="Gray" FontSize="10" Margin="5,2" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pole tekstowe -->
        <Border Grid.Row="2" Background="#FFFFFFFF" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#FFEEEEEE">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox" Grid.Column="0" 
                         VerticalContentAlignment="Center" MinHeight="40"
                         KeyDown="MessageTextBox_KeyDown"
                         Padding="10" BorderBrush="#FFDDDDDD"/>

                <Button Grid.Column="1" Content="Wyślij" 
                        Background="#FFFE3C72" Foreground="White"
                        Padding="15,0" Margin="10,0,0,0" MinHeight="40"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>