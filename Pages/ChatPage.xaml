<Page x:Class="studentoo.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Czat"
      Background="Transparent"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Messages -->
            <RowDefinition Height="Auto"/>
            <!-- Input -->
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Border Grid.Row="0"
            Background="#FFFE3C72"
            Padding="10"
            HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Margin="0,0,10,0">
                    <Image Source="/Icons/back-arrow.png"
                 Height="30" Width="30"
                 Stretch="Uniform"/>
                </Button>

                <!-- KOŁO Z ZDJĘCIEM PARTNERA -->
                <Ellipse x:Name="PartnerEllipse"
                 Width="40" Height="40"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left">
                    <Ellipse.Fill>
                        <ImageBrush Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock x:Name="PartnerNameText"
                   Foreground="White"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Lista wiadomości -->
        <ScrollViewer x:Name="MessagesScrollViewer"
                  Grid.Row="1"
                  Padding="10"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <StackPanel x:Name="MessagesPanel"
                  HorizontalAlignment="Stretch"/>
        </ScrollViewer>

        <!-- Pole tekstowe i przycisk Wyślij -->
        <Border Grid.Row="2"
            Background="White"
            Padding="10"
            BorderThickness="0,1,0,0"
            BorderBrush="#FFEEEEEE"
            HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                 Grid.Column="0"
                 VerticalContentAlignment="Center"
                 MinHeight="40"
                 Padding="10"
                 BorderBrush="#FFDDDDDD"
                 HorizontalAlignment="Stretch"/>

                <Button Grid.Column="1"
                Content="Wyślij"
                Click="SendButton_Click"
                Background="#FFFE3C72"
                Foreground="White"
                Padding="15,0"
                Margin="10,0,0,0"
                MinHeight="40"/>
            </Grid>
        </Border>
    </Grid>
</Page>
